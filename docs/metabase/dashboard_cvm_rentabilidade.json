                    "lib/type": "mbql/query",
                    "database": 2,
                    "stages": [
                        {
                            "lib/type": "mbql.stage/native",
                            "native": "SELECT cnpj_fundo, COALESCE(gestor, 'N\u00e3o informado') AS gestor,\n       ano_mes, ROUND(rentabilidade_mes_pct::numeric, 4) AS rentabilidade_mes_pct\nFROM gold_cvm.fundo_mensal\nWHERE meses_com_dados >= 6 \n  AND vl_quota_inicial >= 0.01 \n  AND vl_quota_final >= 0.01\n  AND rentabilidade_mes_pct BETWEEN -1000 AND 1000\nORDER BY rentabilidade_mes_pct DESC LIMIT 10"
                        }
                    ]
                },
