                        {
                            "lib/type": "mbql.stage/native",
                            "native": "SELECT\n  WIDTH_BUCKET(rentabilidade_mes_pct, -100, 500, 30) AS faixa_bucket,\n  ROUND(MIN(rentabilidade_mes_pct)::numeric, 1) AS faixa_min,\n  ROUND(MAX(rentabilidade_mes_pct)::numeric, 1) AS faixa_max,\n  COUNT(*) AS quantidade\nFROM gold_cvm.fundo_mensal\nWHERE meses_com_dados >= 6 AND rentabilidade_mes_pct BETWEEN -100 AND 500\nGROUP BY faixa_bucket\nORDER BY faixa_bucket"
                        }
                    ]
